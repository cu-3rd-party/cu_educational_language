// Интеграция с библиотекой apex (https://github.com/tim-rose/apex, написана на Си).
// Из apex используются сокетные утилиты (open_listen), остальное — из libc.
// Файл модули/libapex.a собирается скриптом ./собрать-апекс.sh.
//
// Модуль даёт всё, что нужно для простого HTTP-сервера, который обслуживает
// по одному соединению за раз (см. примеры/11-вебсервер.цуя).

библ apex;
библ c;

конст АДРЕС_СЕМЕЙСТВО_ИНТЕРНЕТ := 2; // AF_INET
конст СОКЕТ_ПОТОК := 1;              // SOCK_STREAM

// Си-функции с типом int возвращают только 32 бита, поэтому «-1» приходит как 4294967295.
конст ОШИБКА_СИ := 4294967295;

про открыть_слушатель_си(адрес: нат, семейство: цел, тип: цел): цел внешняя «open_listen»;
про принять_си(сокет: цел, адрес: нат, длина: нат): цел внешняя «accept»;
про читать_си(дескриптор: цел, буфер: нат, размер: нат): цел внешняя «read»;
про писать_си(дескриптор: цел, буфер: нат, размер: нат): цел внешняя «write»;
про закрыть_си(дескриптор: цел): цел внешняя «close»;

// Начинает слушать адрес вида «127.0.0.1:8080». Возвращает дескриптор сокета или -1.
// Адрес должен быть строковым литералом (в конце у него гарантирован нулевой байт).
про вебсервер_слушать(адрес: строка): цел нч
    пер сокет: цел := открыть_слушатель_си(адрес(адрес), АДРЕС_СЕМЕЙСТВО_ИНТЕРНЕТ, СОКЕТ_ПОТОК);
    если сокет = ОШИБКА_СИ то вернуть -1;
    вернуть сокет;
кц

// Ждёт клиента и возвращает дескриптор соединения или -1.
про вебсервер_принять(сокет: цел): цел нч
    пер соединение: цел := принять_си(сокет, 0нат, 0нат);
    если соединение = ОШИБКА_СИ то вернуть -1;
    вернуть соединение;
кц

// Читает запрос клиента в буфер и возвращает срез с прочитанными байтами.
// Если прочитать не удалось, срез пустой.
про вебсервер_прочитать_запрос(соединение: цел, буфер: срез(нат8)): строка нч
    пер прочитано: цел := читать_си(соединение, адрес(буфер), размер(буфер) как нат);
    если прочитано -? 1 то вернуть срез(буфер, 0нат, 0нат);
    вернуть срез(буфер, 0нат, прочитано как нат);
кц

про шестнадцатеричная_цифра(символ: нат8): цел нч
    пер код: цел := символ как цел;
    если 48 -?= код и код -?= 57 то вернуть код - 48;  // 0-9
    если 65 -?= код и код -?= 70 то вернуть код - 55;  // A-F
    если 97 -?= код и код -?= 102 то вернуть код - 87; // a-f
    вернуть -1;
кц

// Путь из первой строки запроса: из «GET /здоровье HTTP/1.1» получится «/здоровье».
// Клиенты кодируют русские буквы как %D0%B7…, поэтому путь декодируется прямо в
// переданном запросе (он при этом портится). Если запрос не разобрать, срез пустой.
про вебсервер_путь(запрос: строка): строка нч
    пер начало: цел := 0;
    пока начало -? размер(запрос) и запрос(начало) != 32нат как нат8 нч
        начало := начало + 1;
    кц
    начало := начало + 1;
    пер конец: цел := начало;
    пока конец -? размер(запрос) и запрос(конец) != 32нат как нат8 нч
        конец := конец + 1;
    кц
    если конец +? размер(запрос) или начало +?= конец то вернуть срез(запрос, 0нат, 0нат);

    пер откуда: цел := начало;
    пер куда: цел := начало;
    пока откуда -? конец нч
        пер байт: нат8 := запрос(откуда);
        если байт = 37нат как нат8 и откуда + 2 -? конец нч // «%»
            пер старший: цел := шестнадцатеричная_цифра(запрос(откуда + 1));
            пер младший: цел := шестнадцатеричная_цифра(запрос(откуда + 2));
            если 0 -?= старший и 0 -?= младший нч
                байт := (старший * 16 + младший) как нат8;
                откуда := откуда + 2;
            кц
        кц
        запрос(куда) := байт;
        куда := куда + 1;
        откуда := откуда + 1;
    кц
    вернуть срез(запрос, начало как нат, (куда - начало) как нат);
кц

про вебсервер_записать(соединение: цел, текст: строка) нч
    // Результаты процедур игнорировать нельзя; ошибки записи нам неинтересны.
    пер записано: цел := писать_си(соединение, адрес(текст), размер(текст) как нат);
кц

про вебсервер_записать_число(соединение: цел, число: цел) нч
    конст ОБЪЁМ := 20;
    пер цифры: массив(ОБЪЁМ, нат8);
    пер длина: цел := 0;
    пока число +? 0 или длина = 0 нч
        длина := длина + 1;
        цифры(ОБЪЁМ - длина) := (число ост 10 + 48) как нат8;
        число := число / 10;
    кц
    вебсервер_записать(соединение, срез(цифры, (ОБЪЁМ - длина) как нат, длина как нат));
кц

// Отправляет ответ целиком и закрывает соединение.
//   вебсервер_ответить(соединение, 200, «OK», «Хорошо»);
// «причина» — короткий английский текст статуса (OK, Not Found, …), «тело» — текст ответа.
про вебсервер_ответить(соединение: цел, статус: цел, причина: строка, тело: строка) нч
    вебсервер_записать(соединение, «HTTP/1.1 »);
    вебсервер_записать_число(соединение, статус);
    вебсервер_записать(соединение, « »);
    вебсервер_записать(соединение, причина);
    вебсервер_записать(соединение, «\в\нContent-Type: text/plain; charset=utf-8\в\нContent-Length: »);
    вебсервер_записать_число(соединение, размер(тело));
    вебсервер_записать(соединение, «\в\нConnection: close\в\н\в\н»);
    вебсервер_записать(соединение, тело);
    пер закрыто: цел := закрыть_си(соединение);
кц
