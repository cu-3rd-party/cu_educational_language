{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"], ["«", "»"], ["нч", "кц"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "«", "close": "»", "notIn": ["comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["«", "»"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "(^|\\s)нч\\s*$",
    "decreaseIndentPattern": "^\\s*кц\\b"
  },
  "wordPattern": "[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*|\\d+(\\.\\d+)?"
}
