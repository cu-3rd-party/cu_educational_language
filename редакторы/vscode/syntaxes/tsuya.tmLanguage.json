{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ЦУЯ",
  "scopeName": "source.cuya",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.cuya", "match": "//.*$" },
        {
          "name": "comment.block.cuya",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#nested-comment" }]
        }
      ]
    },
    "nested-comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.cuya",
      "patterns": [{ "include": "#nested-comment" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cuya",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.other.cuya",
          "begin": "«",
          "end": "»",
          "patterns": [{ "include": "#escape" }, { "include": "#nested-string" }]
        }
      ]
    },
    "nested-string": {
      "name": "string.quoted.other.cuya",
      "begin": "«",
      "end": "»",
      "patterns": [{ "include": "#escape" }, { "include": "#nested-string" }]
    },
    "escape": {
      "name": "constant.character.escape.cuya",
      "match": "\\\\[нт\\\\\"«»]"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cuya", "match": "16%[0-9АБЦДЕФабцдеф]*" },
        { "name": "constant.numeric.float.cuya", "match": "\\b\\d+\\.(?!\\.)\\d*" },
        { "name": "constant.numeric.integer.cuya", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "constant.language.cuya", "match": "(?<![\\p{L}\\p{N}_])(истина|ложь)(?![\\p{L}\\p{N}_])" },
        {
          "name": "keyword.control.cuya",
          "match": "(?<![\\p{L}\\p{N}_])(если|то|иначе|пока|для|вернуть|вилка|когда|любое|нч|кц)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.cuya",
          "match": "(?<![\\p{L}\\p{N}_])(и|или|либо|лбс|пбс|ост|как)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.cuya",
          "match": "(?<![\\p{L}\\p{N}_])(пер|про|конст|структ|вкл|внешняя|библ)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(про)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "keyword.other.cuya" }, "2": { "name": "entity.name.function.cuya" } }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(структ)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "keyword.other.cuya" }, "2": { "name": "entity.name.type.struct.cuya" } }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(конст)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": { "1": { "name": "keyword.other.cuya" }, "2": { "name": "variable.other.constant.cuya" } }
        }
      ]
    },
    "types": {
      "name": "support.type.cuya",
      "match": "(?<![\\p{L}\\p{N}_])(цел|цел64|нат|нат64|нат8|вещ|вещ32|строка|лог|массив|срез)(?![\\p{L}\\p{N}_])"
    },
    "builtins": {
      "name": "support.function.builtin.cuya",
      "match": "(?<![\\p{L}\\p{N}_])(печать|ввод|срез|сисвызов|размер|адрес)(?![\\p{L}\\p{N}_])(?=\\s*\\()"
    },
    "calls": {
      "name": "entity.name.function.call.cuya",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.cuya", "match": ":=" },
        { "name": "keyword.operator.range.cuya", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.cuya", "match": "[+-]\\?=?|!=|=" },
        { "name": "keyword.operator.arithmetic.cuya", "match": "[-+*/]" },
        { "name": "keyword.operator.logical.cuya", "match": "!" }
      ]
    }
  }
}
