// Простенький вебсервер на библиотеке apex. Запустите и откройте в другом терминале:
//
//     curl -i http://127.0.0.1:8080/здоровье
//
// Сервер обслуживает одного клиента за раз и работает, пока его не остановят (Ctrl+C).
// Браузеры кодируют русские буквы в пути (%D0%B7...), поэтому для проверки удобнее curl.

вкл прелюдия;
вкл апекс;

конст ОБЪЁМ_ЗАПРОСА := 4096;

про главная() нч
    пер сокет: цел := вебсервер_слушать(«127.0.0.1:8080»);
    если сокет -? 0 нч
        печать(«Не удалось занять порт 8080\н»);
        вернуть;
    кц
    печать(«Слушаем http://127.0.0.1:8080\н»);

    пер буфер: массив(ОБЪЁМ_ЗАПРОСА, нат8);
    пока истина нч
        пер соединение: цел := вебсервер_принять(сокет);
        если соединение -? 0 то вернуть;

        пер запрос: строка := вебсервер_прочитать_запрос(соединение, срез(буфер, 0нат, ОБЪЁМ_ЗАПРОСА как нат));
        пер путь: строка := вебсервер_путь(запрос);
        печать(«Запрос: », путь, «\н»);

        если строки_равны(путь, «/здоровье») то вебсервер_ответить(соединение, 200, «OK», «Хорошо»);
        иначе то вебсервер_ответить(соединение, 404, «Not Found», «Не найдено»);
    кц
кц
